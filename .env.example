# Copy this file to .env and fill in your key
OPENAI_API_KEY=sk-...

# Optional overrides
# REALTIME_MODEL=gpt-realtime-2.1        # or gpt-realtime-2.1-mini (cheaper/faster)
# REALTIME_VOICE=marin                   # default voice (marin, cedar, alloy) —
#                                        # users can override it by voice ("change your voice to cedar")
# PORT=3000
# NEWS_FEEDS=https://news.google.com/rss  # comma-separated RSS feeds for "what's in the news?"

# Home Assistant — set both to control real devices instead of simulated ones.
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=<long-lived access token from your HA profile page>

# Calendar — a private "secret address in iCal format" from Google/Outlook/iCloud.
# ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics

# Internet radio — JSON map of name → stream URL, merged over the built-in
# SomaFM defaults (jazz, chill, lofi).
# RADIO_STREAMS={"jazz":"https://ice1.somafm.com/sonicuniverse-128-mp3"}

# HTTPS — required for mic access from any second device on the LAN.
# Generate certs with mkcert (see README "Use it on a tablet or phone"):
# HTTPS_CERT=./certs/nova.pem
# HTTPS_KEY=./certs/nova-key.pem

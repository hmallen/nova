# Copy this file to .env and fill in your key
OPENAI_API_KEY=sk-...

# Optional overrides
# REALTIME_MODEL=gpt-realtime-2.1        # or gpt-realtime-2.1-mini (cheaper/faster)
# REALTIME_VOICE=marin                   # default voice (marin, cedar, alloy) —
#                                        # users can override it by voice ("change your voice to cedar")
# PORT=3000
# NEWS_FEEDS=https://news.google.com/rss  # comma-separated RSS feeds for "what's in the news?"
# ROLLOVER_MAX_AGE_MIN=30                # how long a finished conversation stays
#                                        # replayable after a drop, a reload, or the
#                                        # Realtime API's hourly session cap. 0 = off.
# ARCHIVE_TURN_RETENTION_DAYS=90         # how long conversation turns stay in the
#                                        # on-demand archive (data/archive/). Timers,
#                                        # list edits and device changes are kept
#                                        # indefinitely either way. 0 = keep turns too.
# HABIT_SCAN_INTERVAL_H=6                # how often Nova counts patterns in the archive
#                                        # and proposes a habit to remember. Suggestions
#                                        # always need your yes. 0 = off.

# Home Assistant — set both to control real devices instead of simulated ones.
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=<long-lived access token from your HA profile page>

# Calendar, reading — a private "secret address in iCal format" from
# Google/Outlook/iCloud. Read-only: subscription feeds are served over GET and
# cannot be written back to.
# ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics

# Calendar, writing — connect Google Calendar so Nova can create, move and
# cancel events ("put dentist on the calendar for Thursday at two"). Create an
# OAuth client at console.cloud.google.com (APIs & Services → Credentials →
# OAuth client ID → Web application), enable the Google Calendar API, and add
# http://localhost:3000/api/google/callback as an authorized redirect URI.
# Then start Nova and open /api/google/auth once to grant access.
# GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<client secret>
# GOOGLE_CALENDAR_ID=primary              # or a specific calendar's id
# GOOGLE_REDIRECT_URI=                    # only if Nova is reached by another
#                                         # name/port than the one you registered

# Internet radio — JSON map of name → stream URL, merged over the built-in
# SomaFM defaults (jazz, chill, lofi).
# RADIO_STREAMS={"jazz":"https://ice1.somafm.com/sonicuniverse-128-mp3"}

# HTTPS — required for mic access from any second device on the LAN.
# Generate certs with mkcert (see README "Use it on a tablet or phone"):
# HTTPS_CERT=./certs/nova.pem
# HTTPS_KEY=./certs/nova-key.pem
